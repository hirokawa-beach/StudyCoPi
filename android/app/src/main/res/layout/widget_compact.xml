<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="今日の学習" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
            android:text="↻" android:textSize="22sp" android:textColor="@color/widget_accent" android:contentDescription="ウィジェットを更新" />
    </LinearLayout>
    <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日の勉強時間 · 記録済み"
        android:textSize="12sp" android:textColor="@color/widget_secondary" />
    <TextView android:id="@+id/widget_hours" android:layout_width="match_parent" android:layout_height="36dp" android:text="0分"
        android:textSize="24sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textColor="@color/widget_accent" android:paddingBottom="0dp" />
    <TextView android:id="@+id/widget_empty" style="@style/WidgetRow" android:text="今日の予定はありません" />
    <TextView android:id="@+id/widget_row_1" style="@style/WidgetRow" android:text="17:00  数学" />
    <TextView android:id="@+id/widget_row_2" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/widget_row_3" style="@style/WidgetRow" android:visibility="gone" />
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="今日の学習を開く ›" android:textSize="12sp" android:textColor="@color/widget_accent" android:paddingTop="8dp" />
</LinearLayout>

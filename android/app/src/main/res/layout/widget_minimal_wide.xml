<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="148dp" android:layout_centerVertical="true" android:orientation="vertical">
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/widget_sans" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/widget_sans" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textColor="@color/widget_secondary" />
    </LinearLayout>
    <TextView android:id="@+id/widget_hours" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:fontFamily="@font/widget_sans" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="36sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:gravity="center_vertical|end" android:fontFeatureSettings="tnum" android:textColor="@color/widget_text" />
    <TextView android:id="@+id/widget_refresh" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/widget_ring" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_chart_label" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/widget_chart" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_empty" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/widget_row_1" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/widget_row_2" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/widget_row_3" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/widget_more" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</RelativeLayout>
